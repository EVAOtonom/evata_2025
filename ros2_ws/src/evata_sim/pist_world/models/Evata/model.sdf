    <joint name="front_right_wheelSteeringJoint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheelSteering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.8727</lower> 
          <upper>0.8727</upper>  
          <effort>1e6</effort> 
        </limit>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <joint name='front_right_wheelJoint' type='revolute'>
      <parent>front_right_wheelSteering</parent>
      <child>front_right_wheel</child>
      <pose>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>
    
    <joint name="front_left_wheelSteeringJoint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheelSteering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.8727</lower>
          <upper>0.8727</upper>
          <velocity>0.5</velocity> 
          <effort>1e6</effort> 
        </limit>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    
    <joint name="front_left_wheelJoint" type="revolute">
      <parent>front_left_wheelSteering</parent>
      <child>front_left_wheel</child>
      <pose>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <joint name="rear_right_wheelJoint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <pose>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <joint name="rear_left_wheelJoint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <pose>0 0 0 0 -0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>
    <plugin
      filename="ignition-gazebo-ackermann-steering-system"
      name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>front_left_wheelJoint</left_joint>
      <left_joint>rear_left_wheelJoint</left_joint>
      <right_joint>front_right_wheelJoint</right_joint>
      <right_joint>rear_right_wheelJoint</right_joint>
      <left_steering_joint>front_left_wheelSteeringJoint</left_steering_joint>
      <right_steering_joint>front_right_wheelSteeringJoint</right_steering_joint>
      <kingpin_width>0.7</kingpin_width>
      <steering_limit>0.8727</steering_limit>
      <wheel_base>1.52</wheel_base>
      <wheel_separation>0.96</wheel_separation>
      <wheel_radius>0.2032</wheel_radius>
      <min_velocity>-15</min_velocity>
      <max_velocity>100</max_velocity>
      <min_acceleration>-30</min_acceleration>
      <max_acceleration>30</max_acceleration>
      <topic>/cmd_vel</topic>
    </plugin>


    <!-- SENSORS-->
    <!--ŞERİT
    TAKİBİ JABRA Camera-->
    <link name="camera_link">
      <pose>1.3 0.0 0.3 0 0 0</pose> <!-- 90 derece sağa çevrilmiş pose -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
      <pose>0 0 0 0 0 1.5707</pose>
        <geometry>
          <box>
            <size>0.1 0.02 0.02</size>
          </box>
        </geometry>
      </visual>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
      </collision>
      <sensor name="rgb_camera" type="camera">
        <pose>0 0 0 0 0 0</pose> <!-- Kameranın pozisyonunu link merkezine göre sıfırladık -->
        <camera>
          <horizontal_fov>2.900</horizontal_fov>
          <image>
            <width>800</width>
            <height>600</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/camera/rgb</topic>
        <ignition_frame_id>camera_rgb_frame</ignition_frame_id>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose> <!-- Kamera bağlantı pozisyonu -->
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!--Lidar
    Sensör-->
    <link name="lidar_link">
      <pose>1.35 -0.1  0.05 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <pose>0 0 0 0 0 1.5707</pose>
        <geometry>
          <mesh>
            <uri>model://Evata/meshes/lidar_2d_v1.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="lidar_collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
      </collision>

      <sensor name="gpu_lidar" type="gpu_lidar">
        <topic>scan</topic>
        <pose>0.0 0 0 0 0 0</pose>
        <ignition_frame_id>lidar_link</ignition_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-1.5</min_angle>
              <max_angle>1.5</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.060</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <frame name="lidar_frame" attached_to='base_link'>
      <pose>0.0 0 0 0 0 0</pose>
    </frame>

    <joint name="lidar_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- 3D SENSÖR -->
    <link name="lidar_link_3d">
      <pose>-0.1 0.0 1 0 0 1.57</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual_3d">
       <geometry>
          <mesh>
            <uri>model://Evata/meshes/lidar_3d_v1.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="lidar_collision_3d">
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
      </collision>

	<sensor name="helios_32_sim" type="gpu_lidar">
	  <topic>helios</topic>
	  <pose>0.0 0 0 0 0 0</pose>
	  <ignition_frame_id>lidar_link_3d</ignition_frame_id>
	  <ray>
	    <scan>
	      <horizontal>
		<samples>600</samples> <!-- 70 dereceyi temsil edecek kadar -->
		<resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
	      </horizontal>
	      <vertical>
		<samples>32</samples> <!-- Gerçek lidar gibi 32 beam -->
		<resolution>1</resolution>
		<min_angle>-0.2793</min_angle> <!-- yaklaşık -16 derece -->
		<max_angle>0.1571</max_angle>  <!-- yaklaşık +9 derece -->
	      </vertical>
	    </scan>
	    <range>
	      <min>3.0</min>
	      <max>150.0</max>
	      <resolution>0.01</resolution>
	    </range>
	    <noise>
	      <type>gaussian</type>
	      <mean>0.0</mean>
	      <stddev>0.005</stddev> <!-- Hafif arttırılmış gürültü ile daha gerçekçi -->
	    </noise>
	  </ray>
	  <always_on>1</always_on>
	  <update_rate>10</update_rate> <!-- Gerçek zamanlı için ideal denge -->
	  <visualize>false</visualize>
	</sensor>
    </link>
    <frame name="lidar_frame_3d" attached_to='base_link'>
      <pose>0.0 0 0 0 0 0</pose>
    </frame>

    <joint name="lidar_joint_3d" type="fixed">
      <pose>0.0 0 0.0 0 0 0</pose>
      <parent>base_link</parent>
      <child>lidar_link_3d</child>
    </joint>

    <!-- ZED Camera -->
    <link name="zed_camera_link">
      <pose>0.1 0.0 1 0 -0.08 0</pose>
      <collision name="zedcameracollision">
        <origin xyz="0.02 0 0" rpy="0 0 0" />
        <geometry>
          <box>
            <size>0.001 0.001 0.001</size>
          </box>
        </geometry>
      </collision>
      <visual name="zedcameravisual">
        <pose>0 0 0 0 0 1.5707</pose>
        <geometry>
          <mesh>
            <uri>model://Evata/meshes/3dCamera.DAE</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.1</mass>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia>
          <ixx>0.0002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0002</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <!-- ZED Camera Plugin -->

      <sensor type="rgbd_camera" name="zed_depth_camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.396</horizontal_fov> <!-- ZED Kamera FOV -->
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>40</far>
          </clip>
        </camera>
        <topic>/depth_camera/zed</topic>
      </sensor>
    </link>

    <!-- ZED Camera Joint -->
    <joint name="zed_camera_joint" type="fixed">
      <pose>0 0 1.5 0 0 0</pose>
      <parent>base_link</parent>
      <child>zed_camera_link</child>
      <!--<pose>0
      2.2 0.8 0 0 0</pose>-->
    </joint>


    <!-- Global odometer -->
    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <tf_topic>/odom/tf</tf_topic>
    </plugin>
    
    <link name="top_view_camera_link">
   <pose>0 0 10 0 1.5708 0</pose> <!-- Link pozisyonu, joint ile konumlandırılacak -->

  <collision name="top_view_camera_collision">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box>
        <size>0.001 0.001 0.001</size>
      </box>
    </geometry>
  </collision>

  <visual name="top_view_camera_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <box>
        <size>0.05 0.05 0.05</size>
      </box>
    </geometry>
  </visual>

  <inertial>
    <mass>0.1</mass>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia>
      <ixx>0.0002</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>0.0002</iyy>
      <iyz>0</iyz>
      <izz>0.0002</izz>
    </inertia>
  </inertial>

  <sensor name="top_view_camera" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.5708</horizontal_fov> <!-- 90 derece -->
      <image>
        <width>800</width>
        <height>800</height> <!-- Kare görüntü -->
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>
    <plugin name="camera_plugin" filename="libignition-gazebo-camera-system.so"/>
  </sensor>
</link>

<joint name="top_view_camera_joint" type="fixed">
  <pose>0 0 10 0 0 0</pose>  <!-- Aracın üstünde 5m yukarıda -->
  <parent>base_link</parent>  <!-- Aracın gövdesi -->
  <child>top_view_camera_link</child>
</joint>

     <link name="back_view_camera_link">
   <pose>-5 0 2 0 0 0</pose> <!-- Link pozisyonu, joint ile konumlandırılacak -->

  <collision name="back_view_camera_collision">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box>
        <size>0.001 0.001 0.001</size>
      </box>
    </geometry>
  </collision>

  <visual name="back_view_camera_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <box>
        <size>0.05 0.05 0.05</size>
      </box>
    </geometry>
  </visual>

  <inertial>
    <mass>0.1</mass>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia>
      <ixx>0.0002</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>0.0002</iyy>
      <iyz>0</iyz>
      <izz>0.0002</izz>
    </inertia>
  </inertial>

  <sensor name="back_view_camera" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.5708</horizontal_fov> <!-- 90 derece -->
      <image>
        <width>800</width>
        <height>800</height> <!-- Kare görüntü -->
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>
    <plugin name="camera_plugin" filename="libignition-gazebo-camera-system.so"/>
  </sensor>
</link>

<joint name="back_view_camera_joint" type="fixed">
  <pose>-5 0 2 0 0 0</pose>  <!-- Aracın üstünde 5m yukarıda -->
  <parent>base_link</parent>  <!-- Aracın gövdesi -->
  <child>back_view_camera_link</child>
</joint>

    
    
    
    

    <!-- Joint state publisher -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </model>
</sdf>
